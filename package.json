{
  "name": "sgain-website",
  "version": "1.0.0",
  "private": true,
  "description": "SGAIN Website",
  "license": "MIT",
  "author": "tomheaton",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "cf:deploy": "astro build && wrangler deploy",
    "cf:preview": "astro build && wrangler dev",
    "check": "astro check",
    "deploy": "DEPLOY_TARGET=hostinger astro build && ./scripts/deploy.sh",
    "deploy:dry": "DEPLOY_TARGET=hostinger astro build && ./scripts/deploy.sh --dry-run",
    "dev": "astro dev",
    "generate-types": "wrangler types",
    "lint": "biome check",
    "lint:ci": "biome ci --reporter=github",
    "lint:fix": "biome check --fix",
    "og:image": "node scripts/og-image.mjs",
    "preview": "astro preview",
    "svg": "svgo -rf ./public -o ./public",
    "unused": "knip --cache"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.3",
    "@astrojs/markdown-satteri": "0.3.7",
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.33.0",
    "astro": "^7.2.4",
    "motion": "^13.1.1",
    "reading-time": "^1.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.10",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.2.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "d3-geo": "^3.1.1",
    "knip": "^6.32.2",
    "sharp": "^0.35.3",
    "svgo": "^4.1.0",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.3",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.125.0"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": "26.x",
    "pnpm": "11.x"
  }
}
