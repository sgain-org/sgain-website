{
  "name": "sgain-website",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "cf:deploy": "astro build && wrangler deploy",
    "cf:preview": "astro build && wrangler dev",
    "check": "astro check",
    "deploy": "astro build && ./scripts/deploy.sh",
    "deploy:dry": "astro build && ./scripts/deploy.sh --dry-run",
    "dev": "astro dev",
    "generate-types": "wrangler types",
    "lint": "biome check",
    "lint:ci": "biome ci",
    "lint:fix": "biome check --fix",
    "og:image": "node scripts/og-image.mjs",
    "preview": "astro preview",
    "svg": "svgo -rf ./public -o ./public",
    "tree": "./scripts/tree.sh",
    "unused": "knip --cache"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.2",
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.24.0",
    "astro": "^7.0.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^26.1.1",
    "knip": "^6.26.0",
    "sharp": "^0.35.3",
    "svgo": "^4.0.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.110.0"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": "26.x",
    "pnpm": "11.x"
  }
}
