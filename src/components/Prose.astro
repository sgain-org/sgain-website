---
// Prose wrapper for rendered markdown / hand-authored article HTML.
// Children are generated outside this component, so descendant rules use
// the `.prose :global(...)` form to reach them.
---

<article class="content-shell prose">
  <slot />
</article>

<style>
  .content-shell {
    max-width: 900px;
    margin: 0 auto;
  }

  .prose {
    font-family: "Source Serif 4", serif;
    font-size: 1.13rem;
    overflow-wrap: anywhere;
  }

  .prose > :global(*) {
    margin-block: 0;
  }

  .prose > :global(*) + :global(*) {
    margin-top: 1.05rem;
  }

  .prose :global(:is(h1, h2, h3, h4, h5, h6)) {
    color: var(--teal-d);
    font-family: "Fraunces", serif;
    line-height: 1.16;
  }

  .prose :global(h1) {
    max-width: 15ch;
    margin-top: 0;
    font-size: 3rem;
  }

  .prose :global(h2) {
    margin-top: 3.2rem;
    font-size: 2.25rem;
  }

  .prose :global(h3) {
    margin-top: 2.5rem;
    color: var(--teal);
    font-size: 1.7rem;
  }

  .prose :global(h4) {
    margin-top: 2rem;
    color: var(--slate);
    font-size: 1.28rem;
  }

  .prose :global(:is(h5, h6)) {
    margin-top: 1.65rem;
    color: var(--rust);
    font-size: 1rem;
  }

  .prose :global(:is(p, li)) {
    color: var(--ink);
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 700;
  }

  .prose :global(:is(ul, ol)) {
    padding-left: 1.35rem;
  }

  .prose :global(li + li) {
    margin-top: 0.42rem;
  }

  .prose :global(blockquote) {
    margin-left: 0;
    border-left: 4px solid var(--sky);
    padding: 0.2rem 0 0.2rem 1rem;
    color: var(--muted);
  }

  .prose :global(hr) {
    width: 100%;
    height: 1px;
    border: 0;
    background: var(--line);
    margin: 2.5rem 0;
  }

  .prose :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 1.8rem auto;
    border: 1px solid var(--line);
    background: var(--paper);
  }

  .prose > :global(p:has(> img:only-child)) {
    margin: 2rem 0;
  }

  .prose > :global(p:first-of-type:has(> img:only-child)) :global(img) {
    width: 100%;
    max-height: 430px;
    object-fit: cover;
  }

  .prose > :global(p:has(> a:only-child)) {
    display: inline-flex;
    margin-top: 0.9rem;
    margin-right: 0.55rem;
  }

  .prose > :global(p:has(> a:only-child)) :global(a) {
    border: 1px solid var(--teal);
    border-radius: 8px;
    background: var(--paper);
    color: var(--teal-d);
    padding: 0.58rem 0.82rem;
    font-family: "Work Sans", sans-serif;
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
  }

  .prose > :global(p:has(> a:only-child)) :global(a:hover) {
    border-color: var(--rust);
    color: var(--rust);
  }

  .prose :global(.publication-card) {
    border-left: 3px solid var(--teal);
    background: var(--paper2);
    padding: 1rem 1.15rem;
  }

  .prose :global(.publication-card + .publication-card) {
    margin-top: 1rem;
  }

  .prose :global(.publication-card h3) {
    margin-top: 0.25rem;
    font-size: 1.25rem;
  }

  .prose :global(.publication-card h3 a) {
    color: inherit;
  }

  .prose :global(.publication-card p) {
    margin-top: 0.55rem;
  }

  .prose :global(.publication-card__meta) {
    color: var(--rust);
    font-family: "Work Sans", sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-family: "Work Sans", sans-serif;
    font-size: 0.92rem;
  }

  .prose :global(:is(th, td)) {
    border: 1px solid var(--line);
    padding: 0.65rem 0.8rem;
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    background: var(--paper2);
    color: var(--teal-d);
    font-weight: 700;
  }

  @media (max-width: 680px) {
    .prose {
      font-size: 1.04rem;
    }

    .prose :global(h1) {
      font-size: 2.25rem;
    }

    .prose :global(h2) {
      font-size: 1.85rem;
    }

    .prose :global(h3) {
      font-size: 1.45rem;
    }

    .prose > :global(p:first-of-type:has(> img:only-child)) :global(img) {
      max-height: 300px;
    }
  }
</style>
