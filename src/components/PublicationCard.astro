---
type Props = {
  meta: string;
  title: string;
  href: string;
  lines?: string[];
  image?: string;
  imageAlt?: string;
};

const { meta, title, href, lines = [], image, imageAlt = "" } = Astro.props as Props;
---

<article class="publication-card">
  {
    image && (
      <div class="publication-card__media">
        <img src={image} alt={imageAlt} loading="lazy" />
      </div>
    )
  }
  <div class="publication-card__body">
    <p class="publication-card__meta">{meta}</p>
    <h3>
      <a href={href}>{title}</a>
    </h3>
    {lines.map((line) => <p>{line}</p>)}
    <slot />
  </div>
</article>

<style>
  .publication-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-top: 3px solid var(--teal);
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 6px 22px rgba(38, 51, 63, 0.06);
    transition:
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }

  .publication-card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-3px);
  }

  .publication-card__media {
    display: block;
    overflow: hidden;
    aspect-ratio: 5 / 3;
  }

  .publication-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .publication-card:hover .publication-card__media img {
    transform: scale(1.04);
  }

  .publication-card__body {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.35rem 1.4rem;
  }

  .publication-card__meta {
    margin: 0;
    color: var(--rust);
    font-family: "Work Sans", sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .publication-card h3 {
    margin: 0.6rem 0 0;
    font-family: "Fraunces", serif;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .publication-card h3 a {
    color: var(--teal-d);
    text-decoration: none;
  }

  .publication-card h3 a:hover {
    color: var(--rust);
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .publication-card p:not(.publication-card__meta) {
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-family: "Source Serif 4", serif;
    font-size: 0.95rem;
    line-height: 1.55;
  }
</style>
