---
import SocialLinks from "@/components/social/SocialLinks.astro";

const logoWhite = "/logos/SGAIN_Logo_full_white.png";
const bathLogoWhite = "/logos/Uni_of_Bath_logo_white.png";
---

<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <div class="footer-brand">SGAIN Project</div>
      <p>
        Sustainability Governance of China's Global Infrastructure Investments,
        University of Bath.
      </p>
    </div>
    <div>
      <h2>Contact</h2>
      <p>
        <a href="mailto:sgain@bath.ac.uk">sgain@bath.ac.uk</a><br />
        University of Bath, Claverton Down, BA2 7AY
      </p>
    </div>
    <div>
      <h2>Follow</h2>
      <SocialLinks />
    </div>
    <div class="footer-logo">
      <img src={logoWhite} alt="SGAIN Project" />
      <img src={bathLogoWhite} alt="University of Bath" />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    background: var(--slate);
    color: var(--paper);
    padding: 42px 28px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns:
      minmax(0, 1.4fr) minmax(220px, 0.8fr) minmax(180px, 0.7fr)
      auto;
    align-items: start;
    gap: 36px;
    max-width: 1220px;
    margin: 0 auto;
  }

  .footer-logo {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 18px;
    justify-self: end;
  }

  .footer-logo img {
    width: auto;
    height: 70px;
    object-fit: contain;
  }

  .footer-brand,
  .site-footer h2 {
    margin: 0 0 10px;
    font-family: "Fraunces", serif;
    font-size: 1.28rem;
  }

  .site-footer h2 {
    font-size: 1rem;
  }

  .site-footer p {
    margin: 0;
    color: var(--paper2);
  }

  .site-footer a {
    color: var(--paper);
  }

  @media (max-width: 980px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-logo {
      grid-column: 1 / -1;
      align-items: flex-start;
      justify-self: start;
    }
  }

  @media (max-width: 680px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
