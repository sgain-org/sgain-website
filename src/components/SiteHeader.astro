---
import { Menu, X } from "@lucide/astro";

const logoWhite =
  "/images/remote/assets-zyrosite-com/sgain-logo-full-white.png";

const currentPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

const normalize = (href: string) => (href.endsWith("/") ? href : `${href}/`);
const isActive = (href: string) => currentPath === normalize(href);

const navSections = [
  {
    label: "Research",
    links: [
      { href: "/research/", label: "Research" },
      { href: "/cgel-database/", label: "CGEL Database" },
    ],
  },
  {
    label: "Publications",
    links: [
      { href: "/publications/", label: "Publications" },
      {
        href: "/academic-publications/",
        label: "Academic Publications and Policy Reports",
      },
      {
        href: "/non-academic-publications/",
        label: "Non-Academic Publications",
      },
      { href: "/multimedia/", label: "Multimedia" },
    ],
  },
  {
    label: "News & Events",
    links: [
      { href: "/news/", label: "News & Events" },
      {
        href: "/news/bath-conference-on-china-and-global-sustainability-transition/",
        label: "Bath Conference",
      },
      { href: "/news/archive/", label: "Archive" },
      { href: "/blog/", label: "Blog" },
    ],
  },
];

const sectionActive = (links: Array<{ href: string }>) =>
  links.some((link) => isActive(link.href));
---

<a class="skip-link" href="#content">Skip to content</a>

<header class="site-header">
  <div class="site-bar">
    <a class="brand" href="/" aria-label="SGAIN Project home">
      <img class="brand-logo" src={logoWhite} alt="SGAIN Project" />
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <Menu
        class="nav-toggle-icon nav-toggle-open"
        size={28}
        aria-hidden="true"
      />
      <X
        class="nav-toggle-icon nav-toggle-close"
        size={28}
        aria-hidden="true"
      />
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Main navigation">
      <a href="/" class:list={["nav-link", isActive("/") && "active"]}>Home</a>

      {
        navSections.slice(0, 1).map((section) => (
          <details
            class:list={["nav-menu", sectionActive(section.links) && "active"]}
          >
            <summary>{section.label}</summary>
            <div class="nav-panel">
              {section.links.map((link) => (
                <a
                  href={link.href}
                  class:list={[isActive(link.href) && "active"]}
                >
                  {link.label}
                </a>
              ))}
            </div>
          </details>
        ))
      }

      <a
        href="/team/"
        class:list={["nav-link", isActive("/team/") && "active"]}>Team</a
      >
      <a
        href="/network/"
        class:list={["nav-link", isActive("/network/") && "active"]}
      >
        Network
      </a>

      {
        navSections.slice(1).map((section) => (
          <details
            class:list={["nav-menu", sectionActive(section.links) && "active"]}
          >
            <summary>{section.label}</summary>
            <div class="nav-panel">
              {section.links.map((link) => (
                <a
                  href={link.href}
                  class:list={[isActive(link.href) && "active"]}
                >
                  {link.label}
                </a>
              ))}
            </div>
          </details>
        ))
      }

      <a
        href="/contact-information/"
        class:list={[
          "nav-link",
          isActive("/contact-information/") && "active",
        ]}
      >
        Contact
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLElement>(".nav-toggle");
  const nav = document.getElementById("site-nav");
  const header = document.querySelector<HTMLElement>(".site-header");
  const root = document.documentElement;
  const body = document.body;

  const isOpen = () => body.classList.contains("nav-open");

  const setHeaderHeight = () => {
    if (header) {
      root.style.setProperty("--header-h", `${header.offsetHeight}px`);
    }
  };

  window.addEventListener("scroll", () => {
    header?.classList.toggle("scrolled", window.scrollY > 12);
  });

  const openMenu = () => {
    body.classList.add("nav-open");
    toggle?.setAttribute("aria-expanded", "true");
    toggle?.setAttribute("aria-label", "Close menu");
    nav?.querySelector<HTMLElement>("a, summary")?.focus();
  };

  const closeMenu = ({ focusToggle = false } = {}) => {
    body.classList.remove("nav-open");
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Open menu");
    if (focusToggle) toggle?.focus();
  };

  toggle?.addEventListener("click", () => {
    if (isOpen()) {
      closeMenu({ focusToggle: true });
    } else {
      openMenu();
    }
  });

  nav?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement | null)?.closest("a")) closeMenu();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isOpen()) closeMenu({ focusToggle: true });
  });

  // Reset state when resizing up to the desktop breakpoint.
  const desktop = window.matchMedia("(min-width: 981px)");
  desktop.addEventListener("change", (event) => {
    if (event.matches && isOpen()) closeMenu();
  });

  // Keep the overlay's top offset exactly under the sticky header.
  let resizeFrame = 0;
  window.addEventListener("resize", () => {
    cancelAnimationFrame(resizeFrame);
    resizeFrame = requestAnimationFrame(setHeaderHeight);
  });

  setHeaderHeight();
</script>

<style>
  .skip-link {
    position: fixed;
    left: 16px;
    top: 12px;
    z-index: 20;
    transform: translateY(-140%);
    border: 1px solid var(--teal);
    border-radius: 8px;
    background: var(--paper);
    color: var(--teal-d);
    padding: 8px 12px;
    text-decoration: none;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    background: var(--teal-d);
    transition: box-shadow 0.3s var(--ease);
  }

  .site-header.scrolled {
    box-shadow: 0 8px 30px -18px rgba(12, 34, 54, 0.4);
  }

  .site-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    max-width: 1220px;
    min-height: 74px;
    margin: 0 auto;
    padding: 12px 28px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-width: 240px;
    text-decoration: none;
  }

  .brand-logo {
    width: auto;
    height: 52px;
    object-fit: contain;
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .nav-link,
  .nav-menu summary {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 8px 10px;
    color: var(--paper);
    text-decoration: none;
    cursor: pointer;
    transition:
      color 0.2s,
      background 0.2s,
      border-color 0.2s;
  }

  .nav-link:hover,
  .nav-menu:hover summary,
  .nav-menu[open] summary {
    border-color: rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .nav-link.active,
  .nav-menu.active summary {
    color: #fff;
    border-bottom-color: var(--paper);
  }

  .nav-menu {
    position: relative;
  }

  .nav-menu summary {
    list-style: none;
  }

  .nav-menu summary::-webkit-details-marker {
    display: none;
  }

  .nav-menu summary::after {
    content: "";
    width: 6px;
    height: 6px;
    margin-top: -2px;
    margin-left: 8px;
    border-bottom: 1.5px solid currentColor;
    border-right: 1.5px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.25s var(--ease);
  }

  .nav-menu:hover summary::after,
  .nav-menu[open] summary::after,
  .nav-menu:focus-within summary::after {
    transform: rotate(225deg);
  }

  .nav-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    display: grid;
    min-width: 260px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper);
    box-shadow: var(--shadow);
    padding: 8px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity 0.22s var(--ease),
      transform 0.22s var(--ease),
      visibility 0.22s;
  }

  .nav-menu:hover .nav-panel,
  .nav-menu[open] .nav-panel,
  .nav-menu:focus-within .nav-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-panel a {
    display: block;
    border-radius: 8px;
    padding: 9px 10px;
    color: var(--ink);
    text-decoration: none;
  }

  .nav-panel a:hover,
  .nav-panel a.active {
    background: var(--paper2);
    color: var(--teal);
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    margin: -3px -8px -3px 0;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--paper);
    cursor: pointer;
  }

  .nav-toggle:hover {
    color: #fff;
  }

  .nav-toggle :global(.nav-toggle-close) {
    display: none;
  }

  @media (max-width: 980px) {
    .nav-toggle {
      display: inline-flex;
    }

    .site-nav {
      position: fixed;
      inset: var(--header-h, 80px) 0 0 0;
      z-index: 5;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 4px;
      padding: 12px 16px 32px;
      background: var(--teal-d);
      overflow-y: auto;
      overscroll-behavior: contain;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity 0.2s ease,
        transform 0.2s ease,
        visibility 0.2s ease;
    }

    :global(body.nav-open) .site-nav {
      visibility: visible;
      opacity: 1;
      transform: none;
    }

    :global(body.nav-open) {
      overflow: hidden;
    }

    :global(body.nav-open) .nav-toggle :global(.nav-toggle-open) {
      display: none;
    }

    :global(body.nav-open) .nav-toggle :global(.nav-toggle-close) {
      display: block;
    }

    .nav-link,
    .nav-menu summary {
      width: 100%;
      min-width: 0;
      padding: 12px 10px;
      font-size: 1rem;
    }

    .nav-menu {
      position: static;
    }

    .nav-menu summary {
      justify-content: space-between;
    }

    .nav-panel {
      position: static;
      display: none;
      width: 100%;
      margin: 2px 0 6px;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      padding: 4px 4px 4px 14px;
      background: rgba(255, 255, 255, 0.06);
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: none;
    }

    .nav-menu[open] .nav-panel {
      display: grid;
    }

    .nav-panel a {
      color: var(--paper);
    }

    .nav-panel a:hover,
    .nav-panel a.active {
      background: rgba(255, 255, 255, 0.1);
      color: #fff;
    }
  }

  @media (max-width: 680px) {
    .site-bar {
      padding: 12px 16px;
    }

    .brand {
      min-width: 0;
    }

    .brand-logo {
      height: 44px;
    }
  }
</style>
