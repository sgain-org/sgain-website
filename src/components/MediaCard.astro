---
import Cta from "@/components/Cta.astro";

type Props = {
  href: string;
  image: string;
  title: string;
  imageAlt?: string;
  meta?: string;
  cta?: string;
};

const {
  href,
  image,
  title,
  imageAlt = "",
  meta,
  cta = "See more",
} = Astro.props as Props;

const isExternal = href.startsWith("http");
---

<a class="media-card" href={href} target={isExternal ? "_blank" : "_self"} rel={isExternal ? "noopener noreferrer" : undefined}>
  <img src={image} alt={imageAlt} loading="lazy" />
  <span class="media-card__overlay">
    {meta && <span class="media-card__meta">{meta}</span>}
    <span class="media-card__title">{title}</span>
    {cta && <Cta as="span">{cta}</Cta>}
  </span>
</a>

<style>
  .media-card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 14px;
    box-shadow: var(--shadow);
    text-decoration: none;
  }

  .media-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .media-card:hover img {
    transform: scale(1.04);
  }

  .media-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 0.7rem;
    padding: 1.5rem;
    background: linear-gradient(
      0deg,
      rgba(38, 51, 63, 0.88) 0%,
      rgba(38, 51, 63, 0.2) 58%,
      rgba(38, 51, 63, 0) 100%
    );
  }

  .media-card__meta {
    color: var(--paper2);
    font-family: "Work Sans", sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .media-card__title {
    color: #fff;
    font-family: "Fraunces", serif;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 700;
    line-height: 1.18;
  }

  .media-card:hover :global(.cta) {
    border-color: var(--rust);
    color: var(--rust);
  }
</style>
