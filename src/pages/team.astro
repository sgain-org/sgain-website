---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";

const frontmatter = {
  title: "SGAIN: Team | SGAIN Project",
  description:
    "Discover the SGAIN project team, including members from around the globe and our esteemed advisory board. Learn about their affiliations and research areas contributing to the project's success.",
  oldUrl: "https://sgain.org/team",
};

type TeamSectionId = "bath" | "partners" | "advisory" | "alumni";
type TeamGroupId =
  | "bath"
  | "causal-map"
  | "indonesia"
  | "china"
  | "bangladesh"
  | "pakistan";
type TeamAsset = {
  src: string;
  alt: string;
};

const teamMembers = await Promise.all(
  (await getCollection("team")).map(async (entry) => {
    const { Content } = await render(entry);
    return { ...entry, Content };
  }),
);

type TeamMember = (typeof teamMembers)[number];
type TeamGroup = {
  id: string;
  title?: string;
  asset?: TeamAsset;
  members: TeamMember[];
};
type TeamSection = {
  id: string;
  title: string;
  asset?: TeamAsset;
  groups: TeamGroup[];
};

const compareMembers = (first: TeamMember, second: TeamMember) => {
  if (first.data.order !== second.data.order) {
    return first.data.order - second.data.order;
  }

  return first.data.name.localeCompare(second.data.name);
};

const getMembers = (section: TeamSectionId, group?: TeamGroupId) =>
  teamMembers
    .filter(
      (member) =>
        member.data.section === section &&
        (group ? member.data.group === group : true),
    )
    .sort(compareMembers);

const sections: TeamSection[] = [
  {
    id: "bath-team",
    title: "Bath Team",
    asset: {
      src: "/images/remote/assets-zyrosite-com/uob-logo-black-yan920jrrxsn7a5j-6d26b42342.png",
      alt: "University of Bath logo",
    },
    groups: [
      {
        id: "bath",
        members: getMembers("bath", "bath"),
      },
      {
        id: "causal-map",
        title: "Causal Map Team",
        asset: {
          src: "/images/remote/assets-zyrosite-com/causal-map-logorgb-mv07g9kpbkfln289-6507cf55ed.jpg",
          alt: "Causal Map logo",
        },
        members: getMembers("bath", "causal-map"),
      },
    ],
  },
  {
    id: "international-partners",
    title: "International Partners",
    groups: [
      {
        id: "indonesia",
        title: "Team in Indonesia",
        members: getMembers("partners", "indonesia"),
      },
      {
        id: "china",
        title: "Team in China",
        members: getMembers("partners", "china"),
      },
      {
        id: "bangladesh",
        title: "Team in Bangladesh",
        members: getMembers("partners", "bangladesh"),
      },
      {
        id: "pakistan",
        title: "Team in Pakistan",
        members: getMembers("partners", "pakistan"),
      },
    ],
  },
  {
    id: "advisory-board",
    title: "Advisory Board",
    groups: [
      {
        id: "advisory-board-members",
        members: getMembers("advisory"),
      },
    ],
  },
  {
    id: "alumni",
    title: "Alumni",
    groups: [
      {
        id: "alumni-members",
        members: getMembers("alumni"),
      },
    ],
  },
].map(
  (section): TeamSection => ({
    ...section,
    groups: section.groups.filter((group) => group.members.length > 0),
  }),
);

const sectionLinks = sections.map((section) => ({
  id: section.id,
  label: section.title,
}));
---

<Layout frontmatter={frontmatter}>
  <p>
    <img
      src="/images/remote/images-unsplash-com/photo-1684142636731-90ac495fe76c-6838e971b8.jpg"
      alt="an aerial view of a city with a train on the tracks"
    />
  </p>
  <h1><strong>Team</strong></h1>
  <nav class="team-links" aria-label="Team sections">
    {
      sectionLinks.map((section) => (
        <a href={`#${section.id}`}>{section.label}</a>
      ))
    }
  </nav>

  <p>
    <img
      src="/images/remote/assets-zyrosite-com/dsc02337-1-vb0ltdu3uspo4flg-73366ef2ef.jpg"
      alt="Members of the SGAIN project team"
    />
  </p>

  {
    sections.map((section) => (
      <section
        id={section.id}
        class="team-section"
        aria-labelledby={`${section.id}-heading`}
      >
        <h3 id={`${section.id}-heading`}>
          <strong>{section.title}</strong>
        </h3>
        {section.asset && (
          <p class="team-section__asset">
            <img src={section.asset.src} alt={section.asset.alt} />
          </p>
        )}

        {section.groups.map((group) => (
          <div class="team-group">
            {group.title && (
              <h4>
                <strong>{group.title}</strong>
              </h4>
            )}
            {group.asset && (
              <p class="team-section__asset">
                <img src={group.asset.src} alt={group.asset.alt} />
              </p>
            )}

            <div class="team-grid">
              {group.members.map(({ Content, data }) => (
                <article class="team-card">
                  {data.image && (
                    <p class="team-card__image-wrap">
                      <img
                        class="team-card__image"
                        src={data.image}
                        alt={data.imageAlt}
                      />
                    </p>
                  )}

                  <h5 class="team-card__name">
                    {data.profileUrl ? (
                      <a href={data.profileUrl}>{data.name}</a>
                    ) : (
                      data.name
                    )}
                  </h5>

                  {data.role && <p class="team-card__role">{data.role}</p>}

                  <div class="team-card__body">
                    <Content />
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}
      </section>
    ))
  }
</Layout>

<style>
  .team-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.25rem 0 2rem;
  }

  .team-links a {
    border: 1px solid var(--teal);
    background: var(--paper);
    color: var(--teal-d);
    padding: 0.58rem 0.82rem;
    font-family: "Work Sans", sans-serif;
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
  }

  .team-links a:hover {
    border-color: var(--rust);
    color: var(--rust);
  }

  .team-section {
    margin-top: 3rem;
    scroll-margin-top: 110px;
  }

  .team-section__asset img {
    max-width: min(100%, 360px);
  }

  .team-group + .team-group {
    margin-top: 2.5rem;
  }

  .team-grid {
    display: grid;
    gap: 1.25rem;
  }

  .team-card {
    border-left: 3px solid var(--teal);
    background: var(--paper2);
    padding: 1rem 1.15rem;
  }

  .team-card__image-wrap {
    width: min(100%, 280px);
    aspect-ratio: 1 / 1;
    margin: 0 auto;
    overflow: hidden;
  }

  .team-card__image {
    width: 100%;
    height: 100%;
    max-width: none;
    margin: 0;
    object-fit: cover;
    object-position: center top;
  }

  .team-card__name {
    margin: 0;
    color: var(--teal-d);
    font-size: 1.35rem;
  }

  .team-card__name a {
    color: inherit;
  }

  .team-card__role {
    margin: 0.35rem 0 0;
    color: var(--rust);
    font-family: "Work Sans", sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .team-card__body {
    margin-top: 0.85rem;
  }

  .team-card__body :global(p) {
    margin: 0;
  }

  .team-card__body :global(p + p) {
    margin-top: 0.75rem;
  }

  @media (min-width: 760px) {
    .team-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
