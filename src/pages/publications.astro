---
import Band from "@/components/Band.astro";
import CardGrid from "@/components/CardGrid.astro";
import Hero from "@/components/Hero.astro";
import MediaCard from "@/components/MediaCard.astro";
import Prose from "@/components/Prose.astro";
import SectionDivider from "@/components/SectionDivider.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import Layout from "@/layouts/Layout.astro";

const frontmatter = {
  title: "Publications | SGAIN Project",
  description: "",
  oldUrl: "https://sgain.org/publications",
};
---

<Layout frontmatter={frontmatter} bare>
  <Hero
    image="/images/remote/images-unsplash-com/photo-1528214968864-8dd00782fa9e-132b852a90.jpg"
    title="Publications"
  >
    <p>
      Below you can find a sample of our most recent publications, as well as
      navigation to our different publications, including journal articles and
      books, non-academic publications, policy briefs, and mentions of SGAIN and
      our work in the media
    </p>
  </Hero>

  <Band>
    <Prose>
      <article class="publication-card">
        <p class="publication-card__meta">Most recent article</p>
        <h3>
          <a
            href="/publications/dataset-development-in-earth-system-governance-learnings-stakes-and-pathways-for-impact/"
            >Dataset development in earth system governance: Learnings, stakes,
            and pathways for impact.</a
          >
        </h3>
        <p>
          Morin, J.-F., Hollway, J., Sun, Y., Vadrot, A. B. M., Allan, J.,
          Bernauer, T., Betsill, M. M., Brandi, C., Fast, C., Kim, R. E.,
          Laurens, N., Lecavalier, E., McCracken, M., Mitchell, R. B., Morton,
          K., Orsini, A., Papin, M., Rowan, S., &amp; Widerberg, O. E., 2026.
          Earth System Governance, 28, 100328
        </p>
        <p>6/1/2026</p>
      </article>
      <article class="publication-card">
        <p class="publication-card__meta">Most recent article</p>
        <h3>
          <a
            href="/publications/varieties-of-local-implementation-for-net-zero-in-china-evidence-from-three-cities/"
            >Varieties of Local Implementation for Net Zero in China: Evidence
            From Three Cities</a
          >
        </h3>
        <p>Guan, T., Gou, Z., and Sun, Y. 2026.</p>
        <p>5/24/2026</p>
      </article>
      <article class="publication-card">
        <p class="publication-card__meta">Most recent article</p>
        <h3>
          <a
            href="/publications/compound-path-dependence-in-green-transitions-a-comparative-analysis-of-ev-policy-coordination-in-indonesia-and-thailand/"
            >Compound path dependence in green transitions: a comparative
            analysis of EV policy coordination in Indonesia and Thailand</a
          >
        </h3>
        <p>Ye, C., Xia, Y., Sun, Y., and Cashore, B., 2026.</p>
        <p>5/20/2026</p>
      </article>
      <article class="publication-card">
        <p class="publication-card__meta">Most recent book</p>
        <h3>
          <a
            href="/publications/climate-governance-in-china-a-multiactor-perspective/"
            >Climate governance in China: a multi-actor perspective</a
          >
        </h3>
        <p>
          Ye, Y., and Sun, Y., 2026. in: Handbook of Research on Sustainability
          and Governance
        </p>
        <p>3/17/2026</p>
      </article>
    </Prose>
  </Band>

  <SectionDivider />

  <Band>
    <SectionTitle>Explore our publications</SectionTitle>
    <CardGrid>
      <MediaCard
        href="/articles-and-book-chapters/"
        image="/images/remote/images-unsplash-com/photo-1610116306796-6fea9f4fae38-ab23508359.jpg"
        imageAlt="white and brown book on brown woven surface"
        title="Articles and Book Chapters"
      />
      <MediaCard
        href="/non-academic-publications/#non-academic"
        image="/images/remote/images-unsplash-com/photo-1482876555840-f31c5ebbff1c-7102bf977b.jpg"
        imageAlt="person holding book"
        title="Non-Academic Publications"
      />
      <MediaCard
        href="/policy-briefs-and-reports/"
        image="/images/remote/images-unsplash-com/photo-1454165804606-c3d57bc86b40-d476d060c9.jpg"
        imageAlt="person holding pencil near laptop computer"
        title="Policy Briefs and Reports"
      />
      <MediaCard
        href="/non-academic-publications/#media-coverage"
        image="/images/remote/images-unsplash-com/photo-1573152143286-0c422b4d2175-027b50c708.jpg"
        imageAlt="people using phone while standing"
        title="Media Coverage"
      />
    </CardGrid>
  </Band>
</Layout>
