---
import SocialLinks from "../components/social/SocialLinks.astro";
import Layout from "../layouts/Layout.astro";

const frontmatter = {
  title: "SGAIN: Contact Information | SGAIN Project",
  description:
    "Find all the contact information for the SGAIN Project here. Submit your questions using our form, reach out via email for more project information, or follow our social media.",
  oldUrl: "https://sgain.org/contact-information",
};
---

<Layout frontmatter={frontmatter} bare>
  <header
    class="page-hero"
    style='--hero-image: url("/images/remote/images-unsplash-com/photo-1718127581405-19e304c855b3-8ff00e8b38.jpg")'
  >
    <div class="page-hero__inner">
      <h1><strong>Contact Us</strong></h1>
    </div>
  </header>

  <section class="band">
    <div class="contact-grid">
      <div class="contact-card">
        <p class="contact-follow">Follow SGAIN on social media.</p>
        <div class="contact-social">
          <SocialLinks />
        </div>
        <div class="contact-actions">
          <a
            class="contact-btn"
            href="https://www.linkedin.com/company/sgain/?viewAsMember=true"
            target="_blank"
            rel="noopener noreferrer"
          >
            Social Media
          </a>
          <a class="contact-btn" href="mailto:sgain@bath.ac.uk">Email</a>
          <a class="contact-btn" href="#contact-us">Send a Message</a>
        </div>
      </div>

      <section
        class="contact-card contact-message"
        id="contact-us"
        aria-labelledby="contact-us-title"
      >
        <h2 id="contact-us-title" class="section-title">Send a Message</h2>
        <p>
          Reach the team directly at <a href="mailto:sgain@bath.ac.uk"
            >sgain@bath.ac.uk</a
          >.
        </p>
      </section>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .page-hero {
    background:
      linear-gradient(
        180deg,
        rgba(43, 74, 100, 0.82) 0%,
        rgba(43, 74, 100, 0.5) 45%,
        rgba(43, 74, 100, 0.74) 100%
      ),
      var(--hero-image) center / cover no-repeat;
    color: var(--paper);
    padding: clamp(3.5rem, 9vw, 6.5rem) 24px;
  }

  .page-hero__inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .page-hero h1 {
    margin: 0;
    color: #fff;
    font-family: "Fraunces", serif;
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-align: center;
  }

  /* Band */
  .band {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4rem) 24px;
  }

  .section-title {
    margin: 0 0 1rem;
    color: var(--teal-d);
    font-family: "Fraunces", serif;
    font-size: clamp(1.5rem, 2.5vw, 1.9rem);
    font-weight: 700;
    line-height: 1.16;
  }

  /* Contact layout */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
    max-width: 880px;
    margin: 0 auto;
  }

  .contact-card {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #fff;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    box-shadow: 0 6px 22px rgba(38, 51, 63, 0.06);
  }

  .contact-follow {
    margin: 0;
    color: var(--teal-d);
    font-family: "Fraunces", serif;
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .contact-social {
    margin-top: 1.1rem;
    color: var(--teal-d);
  }

  .contact-actions {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .contact-btn {
    border: 1px solid var(--teal);
    background: var(--paper);
    color: var(--teal-d);
    padding: 0.7rem 1rem;
    font-family: "Work Sans", sans-serif;
    font-size: 0.86rem;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }

  .contact-btn:hover {
    border-color: var(--rust);
    color: var(--rust);
  }

  .contact-message p {
    margin: 0;
    color: var(--ink);
    font-family: "Source Serif 4", serif;
    font-size: 1.13rem;
    line-height: 1.62;
  }

  .contact-message a {
    color: var(--teal);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }

  .contact-message a:hover {
    color: var(--rust);
  }

  @media (min-width: 760px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
