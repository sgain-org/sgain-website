---
import SocialLinks from "../components/social/SocialLinks.astro";
import Layout from "../layouts/Layout.astro";

const frontmatter = {
  title: "SGAIN: Contact Information | SGAIN Project",
  description:
    "Find all the contact information for the SGAIN Project here. Submit your questions using our form, reach out via email for more project information, or follow our social media.",
  oldUrl: "https://sgain.org/contact-information",
};
---

<Layout frontmatter={frontmatter}>
  <p>
    <img
      src="/images/remote/images-unsplash-com/photo-1718127581405-19e304c855b3-8ff00e8b38.jpg"
      alt="a body of water with waves coming in and out of it"
    />
  </p>
  <h1><strong>Contact Us</strong></h1>
  <p>Follow SGAIN on social media.</p>
  <SocialLinks />
  <p>
    <a
      href="https://www.linkedin.com/company/sgain/?viewAsMember=true"
      target="_blank"
      rel="noopener noreferrer"
    >
      Social Media
    </a>
  </p>
  <p><a href="mailto:sgain@bath.ac.uk">Email</a></p>
  <p><a href="#contact-us">Send a Message</a></p>

  <section id="contact-us" aria-labelledby="contact-us-title">
    <h2 id="contact-us-title">Send a Message</h2>
    <p>
      Reach the team directly at <a href="mailto:sgain@bath.ac.uk"
        >sgain@bath.ac.uk</a
      >.
    </p>
  </section>
</Layout>
