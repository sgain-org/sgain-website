---
import Band from "@/components/Band.astro";
import Hero from "@/components/Hero.astro";
import SocialLinks from "@/components/social/SocialLinks.astro";
import Layout from "@/layouts/Layout.astro";

const frontmatter = {
  title: "SGAIN: Contact Information | SGAIN Project",
  description:
    "Find all the contact information for the SGAIN Project here. Reach out via email for more project information, or follow our social media.",
  oldUrl: "https://sgain.org/contact-information",
};
---

<Layout frontmatter={frontmatter} bare>
  <Hero
    image="/images/remote/images-unsplash-com/photo-1718127581405-19e304c855b3-8ff00e8b38.jpg"
    title="Contact Us"
  />

  <Band>
    <div class="contact">
      <h2 class="contact-title">Get in touch</h2>

      <p class="contact-text">Follow SGAIN on social media.</p>
      <div class="contact-social">
        <SocialLinks size={28} />
      </div>

      <p class="contact-text">
        Or email the team at <a href="mailto:sgain@bath.ac.uk"
          >sgain@bath.ac.uk</a
        >.
      </p>
    </div>
  </Band>
</Layout>

<style>
  .contact {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }

  .contact-title {
    margin: 0 0 1.5rem;
    color: var(--teal-d);
    font-family: "Fraunces", serif;
    font-size: clamp(1.5rem, 2.5vw, 1.9rem);
    font-weight: 700;
    line-height: 1.16;
  }

  .contact-social {
    display: flex;
    justify-content: center;
    margin: 1.25rem 0 2rem;
    color: var(--teal-d);
  }

  .contact-text {
    margin: 0;
    color: var(--ink);
    font-family: "Source Serif 4", serif;
    font-size: 1.13rem;
    line-height: 1.62;
  }

  .contact-text a {
    color: var(--teal);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }

  .contact-text a:hover {
    color: var(--rust);
  }
</style>
