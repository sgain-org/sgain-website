---
import { ArrowLeftIcon } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Page Not Found | SGAIN Project"
  description="The page you were looking for does not exist. Return to the SGAIN Project website."
>
  <section class="notfound">
    <div class="wrap" data-reveal>
      <p class="code">Error 404</p>
      <h1>Page not found</h1>
      <p class="lead">
        The page you're looking for doesn't exist. The link may be out of date,
        or the address mistyped.
      </p>
      <a class="home-link" href="/">
        <ArrowLeftIcon size={16} />Back to the homepage
      </a>
    </div>
  </section>
</Layout>

<style>
  .notfound {
    padding: 90px 0;
    text-align: center;
  }

  .code {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 10px;
  }

  h1 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(26px, 4vw, 38px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--teal-d);
  }

  .lead {
    max-width: 46ch;
    margin: 12px auto 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink-soft);
  }

  .home-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    padding: 11px 20px;
    border-radius: 9px;
    background: var(--teal);
    color: #fff;
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 600;
    transition: 0.2s;
  }

  .home-link:hover {
    background: var(--teal-d);
  }

  @media (max-width: 600px) {
    .notfound {
      padding: 64px 0;
    }
  }
</style>
