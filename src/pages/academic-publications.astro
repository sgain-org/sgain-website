---
import Band from "@/components/Band.astro";
import Hero from "@/components/Hero.astro";
import SectionDivider from "@/components/SectionDivider.astro";
import Layout from "@/layouts/Layout.astro";

const frontmatter = {
  title: "Academic Publications and Policy Reports | SGAIN Project",
  description: "",
  oldUrl: "https://sgain.org/academic-publications-and-policy-reports",
};
---

<Layout frontmatter={frontmatter} bare>
  <Hero
    image="/images/remote/images-unsplash-com/photo-1528214968864-8dd00782fa9e-132b852a90.jpg"
    title="Academic Publications"
  />

  <Band>
    <div class="pub-section__head">
      <h4 id="academic-publications" class="pub-section__title">
        Latest Academic Publications
      </h4>
      <h6 class="section-lead">
        Read the most recent publications from members of our team in journals
        and books
      </h6>
    </div>

    <div class="pub-grid">
      <article class="publication-card">
        <p class="publication-card__meta">Most recent article</p>
        <h3>
          <a
            href="/publications/dataset-development-in-earth-system-governance-learnings-stakes-and-pathways-for-impact/"
            >Dataset development in earth system governance: Learnings, stakes,
            and pathways for impact.</a
          >
        </h3>
        <p>
          Morin, J.-F., Hollway, J., Sun, Y., Vadrot, A. B. M., Allan, J.,
          Bernauer, T., Betsill, M. M., Brandi, C., Fast, C., Kim, R. E.,
          Laurens, N., Lecavalier, E., McCracken, M., Mitchell, R. B., Morton,
          K., Orsini, A., Papin, M., Rowan, S., &amp; Widerberg, O. E., 2026.
          Earth System Governance, 28, 100328
        </p>
      </article>
      <article class="publication-card">
        <p class="publication-card__meta">Most recent article</p>
        <h3>
          <a
            href="/publications/varieties-of-local-implementation-for-net-zero-in-china-evidence-from-three-cities/"
            >Varieties of Local Implementation for Net Zero in China: Evidence
            From Three Cities</a
          >
        </h3>
        <p>Guan, T., Gou, Z., and Sun, Y. 2026.</p>
      </article>
      <article class="publication-card">
        <p class="publication-card__meta">Most recent article</p>
        <h3>
          <a
            href="/publications/compound-path-dependence-in-green-transitions-a-comparative-analysis-of-ev-policy-coordination-in-indonesia-and-thailand/"
            >Compound path dependence in green transitions: a comparative
            analysis of EV policy coordination in Indonesia and Thailand</a
          >
        </h3>
        <p>Ye, C., Xia, Y., Sun, Y., and Cashore, B., 2026.</p>
      </article>
      <article class="publication-card">
        <p class="publication-card__meta">Most recent book</p>
        <h3>
          <a
            href="/publications/climate-governance-in-china-a-multiactor-perspective/"
            >Climate governance in China: a multi-actor perspective</a
          >
        </h3>
        <p>
          Ye, Y., and Sun, Y., 2026. in: Handbook of Research on Sustainability
          and Governance
        </p>
      </article>
      <article class="publication-card">
        <p class="publication-card__meta">Most recent article</p>
        <h3>
          <a
            href="/publications/is-goalsetting-an-effective-strategy-for-global-sustainability-governance-insights-from-the-sustainable-development-goals/"
            >Is goal-setting an effective strategy for global sustainability
            governance? Insights from the Sustainable Development Goals</a
          >
        </h3>
        <p>Hickmann, T., Senit, C.A., and Sun, Y., 2026.</p>
      </article>
      <article class="publication-card">
        <p class="publication-card__meta">Most recent article</p>
        <h3>
          <a
            href="/publications/global-environmental-politics-amid-geopolitical-turbulence/"
            >Global Environmental Politics amid Geopolitical Turbulence</a
          >
        </h3>
        <p>
          Sun, Y., Clapp, J., Andonova, L., Dauvergne, P., Jayaram, D., Mbeva,
          K., Paterson, M., Wijaya, T., and Wu, F. 2026. Global Environmental
          Politics
        </p>
      </article>
    </div>
  </Band>

  <SectionDivider />

  <Band>
    <div class="pub-section__head">
      <h4 id="policy-briefs" class="pub-section__title">
        SGAIN Policy Briefs and Reports
      </h4>
      <h6 class="section-lead">
        All publications in our policy brief and report series will be open
        access and shared here on our website.
      </h6>
    </div>

    <div class="pub-grid">
      <article class="publication-card">
        <p class="publication-card__meta">Most recent policy report</p>
        <h3>
          <a
            href="/publications/china-and-global-sustainability-transition-outlook-2025/"
            >China and Global Sustainability Transition Outlook 2025</a
          >
        </h3>
        <p>
          China&#39;s emerging leadership in global sustainability governance
          amind geopolitical turbulence.
        </p>
        <p>
          Sun, Y., Chant, F., O’Brien, C., Ye, Y., Li, J., Gu, Y., &amp; Xiao,
          Y.
        </p>
        <p>12/30/2025</p>
      </article>
      <article class="publication-card">
        <p class="publication-card__meta">Policy report</p>
        <h3>
          <a
            href="/publications/from-solar-boom-to-green-industrialization-policy-pathways-to-localizing-solar-value-chains-in-pakistan/"
            >From Solar Boom to Green Industrialization: Policy Pathways to
            Localizing Solar Value Chains in Pakistan</a
          >
        </h3>
        <p>Sustainable Development Policy Institute (SDPI) and SGAIN</p>
        <p>11/14/2025</p>
      </article>
      <article class="publication-card">
        <p class="publication-card__meta">Policy report</p>
        <h3>
          <a
            href="/publications/towards-a-just-transition-integrating-fair-share-equity-and-justice-into-climate-transition-plans/"
            >Towards a Just Transition: Integrating Fair Share, Equity and
            Justice into Climate Transition Plans</a
          >
        </h3>
        <p>Race to Zero Working Group Report</p>
        <p>11/3/2025</p>
      </article>
    </div>
  </Band>

  <SectionDivider />

  <Band prose>
    <div class="pub-section__head">
      <h4 class="pub-section__title">Previous Publications</h4>
      <h6 class="section-lead">
        In this section you can find academic publications from members of our
        core and wider team prior to the launch of the SGAIN Project
      </h6>
    </div>

    <div class="reference-list">
      <h6 class="reference">
        Wang, Y., Liu, C., &amp; Sun, Y. (2024). <a
          href="https://www.sciencedirect.com/science/article/pii/S2214629624000471?via%3Dihub"
          >No more coal abroad! Unpacking the drivers of China’s green shift in
          overseas energy finance.</a
        >
        <em
          ><a
            href="https://www.sciencedirect.com/science/article/pii/S2214629624000471?via%3Dihub"
            >Energy Research &amp; Social Science</a
          ></em
        ><a
          href="https://www.sciencedirect.com/science/article/pii/S2214629624000471?via%3Dihub"
          >,</a
        >
        <em
          ><a
            href="https://www.sciencedirect.com/science/article/pii/S2214629624000471?via%3Dihub"
            >111</a
          ></em
        ><a
          href="https://www.sciencedirect.com/science/article/pii/S2214629624000471?via%3Dihub"
          >, 103456.</a
        >
      </h6>
      <h6 class="reference">
        Sun, Y., Lewis, J. I., &amp; Urpelainen, J. (2023). <a
          href="https://www.tandfonline.com/doi/full/10.1080/09644016.2023.2251372"
          >Environmental governance of China’s Belt and Road Initiative.</a
        >
        <em
          ><a
            href="https://www.tandfonline.com/doi/full/10.1080/09644016.2023.2251372"
            >Environmental Politics</a
          ></em
        ><a
          href="https://www.tandfonline.com/doi/full/10.1080/09644016.2023.2251372"
          >,</a
        >
        <em
          ><a
            href="https://www.tandfonline.com/doi/full/10.1080/09644016.2023.2251372"
            >32</a
          ></em
        ><a
          href="https://www.tandfonline.com/doi/full/10.1080/09644016.2023.2251372"
          >(7), 1109–1116.</a
        >
      </h6>
      <h6 class="reference">
        Sun, Y., &amp; Yu, B. (2023). <a
          href="https://direct.mit.edu/glep/article/23/1/91/113840/Greening-China-s-Belt-and-Road-Initiative-From"
          >Greening China’s Belt and Road Initiative: From Norm Localization to
          Norm Subsidiarity?</a
        >
        <em
          ><a
            href="https://direct.mit.edu/glep/article/23/1/91/113840/Greening-China-s-Belt-and-Road-Initiative-From"
            >Global Environmental Politics</a
          ></em
        ><a
          href="https://direct.mit.edu/glep/article/23/1/91/113840/Greening-China-s-Belt-and-Road-Initiative-From"
          >,</a
        >
        <em
          ><a
            href="https://direct.mit.edu/glep/article/23/1/91/113840/Greening-China-s-Belt-and-Road-Initiative-From"
            >23</a
          ></em
        ><a
          href="https://direct.mit.edu/glep/article/23/1/91/113840/Greening-China-s-Belt-and-Road-Initiative-From"
          >(1), 91–116.</a
        >
      </h6>
    </div>
  </Band>
</Layout>

<style>
  /* Section headers */
  .pub-section__head {
    margin-bottom: clamp(1.5rem, 4vw, 2.25rem);
  }

  .pub-section__title {
    margin: 0;
    scroll-margin-top: 100px;
    color: var(--teal-d);
    font-family: "Fraunces", serif;
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    font-weight: 700;
    line-height: 1.16;
  }

  .section-lead {
    margin: 0.55rem 0 0;
    max-width: 70ch;
    color: var(--muted);
    font-family: "Source Serif 4", serif;
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.55;
  }

  /* Previous publications — reference list */
  .reference-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .reference {
    margin: 0;
    border-left: 3px solid var(--teal);
    padding: 0.3rem 0 0.3rem 1rem;
    color: var(--ink);
    font-family: "Source Serif 4", serif;
    font-size: 1.02rem;
    font-weight: 400;
    line-height: 1.6;
  }

  .reference a {
    color: var(--teal);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }

  .reference a:hover {
    color: var(--rust);
  }

  .reference em {
    font-style: italic;
  }

  /* Publication cards */
  .pub-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    align-items: start;
  }

  .publication-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-top: 3px solid var(--teal);
    border-radius: 12px;
    background: #fff;
    padding: 1.25rem 1.35rem 1.4rem;
    box-shadow: 0 6px 22px rgba(38, 51, 63, 0.06);
    transition:
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }

  .publication-card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-3px);
  }

  .publication-card__meta {
    margin: 0;
    color: var(--rust);
    font-family: "Work Sans", sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .publication-card h3 {
    margin: 0.6rem 0 0;
    font-family: "Fraunces", serif;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .publication-card h3 a {
    color: var(--teal-d);
    text-decoration: none;
  }

  .publication-card h3 a:hover {
    color: var(--rust);
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .publication-card p:not(.publication-card__meta) {
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-family: "Source Serif 4", serif;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  @media (min-width: 720px) {
    .pub-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
