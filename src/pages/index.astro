---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="CGEL Database — China's Global Environmental Leadership"
  description="The first and most comprehensive database of cross-border environmental governance initiatives led by Chinese state and non-state actors in the 21st century. A SGAIN project, University of Bath."
>
  <header>
    <div class="wrap">
      <div class="eyebrow">
        China's Global Environmental Leadership · 2000–2024
      </div>
      <h1 class="title">
        China's Global Environmental <em>Leadership</em> Database
      </h1>
      <p class="lede">
        The first and most comprehensive database of cross-border environmental
        governance initiatives led by Chinese state and non-state actors in the
        21st century. A SGAIN project output, University of Bath.
      </p>
      <div class="stats" id="statbar"></div>
    </div>
  </header>

  <section class="viz-row">
    <div class="wrap">
      <div class="viz-head">
        <h2 class="serif">
          Temporal Evolution of Chinese-led initiatives across governance levels
          and scales
        </h2>
        <p>
          China has become increasingly active in leading cross-border
          environmental governance, with state agencies driving this expansion.
          The widening spatial footprint reflects not only the diversification
          of China's environmental partnerships but also its growing ambition to
          shape global environmental agendas.
        </p>
      </div>
      <div id="chart-temporal" class="chartbox"></div>
    </div>
  </section>

  <section class="viz-row">
    <div class="wrap">
      <div class="viz-head">
        <h2 class="serif">Governance functions across multiple levels</h2>
        <p>
          'Information sharing' and 'Capacity-building' emerged as key emphases.
          In contrast, the provision of funding remains consistently limited,
          setting China apart from traditional aid-based models of environmental
          cooperation.
        </p>
      </div>
      <div id="chart-heatmap" class="chartbox"></div>
    </div>
  </section>

  <section class="viz-row">
    <div class="wrap">
      <div class="viz-head">
        <h2 class="serif">
          Environmental problems targeted by these initiatives across levels
        </h2>
        <p>
          China's efforts to lead global environmental governance primarily
          focus on climate change (30%), followed respectively by energy (16%),
          water (12%). Meanwhile, around 11% of the initiatives in our database
          address broad environmental issues without having a specific focus.
        </p>
      </div>
      <div id="chart-problems" class="chartbox"></div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head">
        <h2 class="serif">Where China collaborates</h2>
        <p>
          Countries shaded by the number of initiatives in which they are the
          primary international collaborator. Adjust the year range; click a
          country to explore it in Browse.
        </p>
      </div>
      <div class="yearbar">
        <label>From</label><span class="yv" id="y0">1980</span>
        <div class="dualrange">
          <div class="dr-rail"></div>
          <div class="dr-fill" id="yfill" style="left: 0; width: 100%"></div>
          <input
            type="range"
            id="ymin"
            min="1980"
            max="2024"
            value="1980"
            aria-label="From year"
          >
          <input
            type="range"
            id="ymax"
            min="1980"
            max="2024"
            value="2024"
            aria-label="To year"
          >
        </div>
        <span class="yv" id="y1">2024</span><label>To</label>
      </div>
      <div id="map"></div>
      <div class="map-note">
        Each country is labelled with its ISO 3166-1 alpha-2 code (UN standard)
        and shaded by the number of initiatives in which it is the primary
        international collaborator; multi-country collaborators are split and
        counted once each.
        <strong
          >The database covers governance initiatives active during 2000–2024,
          but includes cases that started before 2000 (the earliest is 1980) and
          remained active afterward — hence the year filter extends back to
          1980.</strong
        >
      </div>
    </div>
  </section>
</Layout>

<script>
import * as d3 from "d3";
import type { Initiative, WorldGeo } from "../lib/data";
import { loadGeo, loadInitiatives, yrInt } from "../lib/data";

let DATA: Initiative[] = [],
  GEO: WorldGeo | null = null;
const F = { ymin: 1980, ymax: 2024 };
function inYears(d: Initiative) {
  const y = yrInt(d);
  if (y === null) return true;
  return y >= F.ymin && y <= F.ymax;
}
function renderStatbar() {
  document.getElementById("statbar")!.innerHTML = [
    ["291", "Initiatives"],
    ["56", "Collaborating countries"],
    [new Set(DATA.map((d) => d.region).filter(Boolean)).size, "Regions"],
    ["2000–2024", "Inclusion window"],
    ["29", "Variables"],
  ]
    .map(
      ([n, l]) =>
        `<div class="stat"><div class="n">${n}</div><div class="l">${l}</div></div>`,
    )
    .join("");
}
function syncYears() {
  let a = +(document.getElementById("ymin") as HTMLInputElement).value,
    b = +(document.getElementById("ymax") as HTMLInputElement).value;
  if (a > b) {
    [a, b] = [b, a];
  }
  F.ymin = a;
  F.ymax = b;
  document.getElementById("y0")!.textContent = `${a}`;
  document.getElementById("y1")!.textContent = `${b}`;
  const lo = ((a - 1980) / (2024 - 1980)) * 100,
    hi = ((b - 1980) / (2024 - 1980)) * 100;
  const fill = document.getElementById("yfill");
  if (fill) {
    fill.style.left = `${lo}%`;
    fill.style.width = `${hi - lo}%`;
  }
  paintMap();
}
document.getElementById("ymin")?.addEventListener("input", syncYears);
document.getElementById("ymax")?.addEventListener("input", syncYears);
// ===== MAP (D3 Natural Earth projection — no edge-overflow streaks) =====
const ISO: Record<string, string> = {
