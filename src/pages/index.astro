---
import Hero from "../components/Hero.astro";
import MediaCard from "../components/MediaCard.astro";
import Layout from "../layouts/Layout.astro";

const frontmatter = {
  title:
    "SGAIN Project: Sustainability Governance of China's Global Infrastructure Investments | SGAIN Project",
  description:
    "Discover key information about the SGAIN Project based at the University of Bath. Explore our website for detailed insights and links to subpages about this academic research initiative.",
  oldUrl: "https://sgain.org",
};

const heroImage =
  "/images/remote/images-unsplash-com/photo-1515344905723-babc01aac23d.jpg";
---

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .about__figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  .about h2 {
    margin: 0 0 1.1rem;
    color: var(--teal-d);
    font-family: "Fraunces", serif;
    font-size: clamp(1.7rem, 3vw, 2.25rem);
    font-weight: 700;
    line-height: 1.16;
  }

  .about p {
    margin: 0 0 1.5rem;
    color: var(--ink);
    font-family: "Source Serif 4", serif;
    font-size: 1.08rem;
    line-height: 1.62;
  }

  @media (max-width: 720px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>

<Layout frontmatter={frontmatter} bare>
  <Hero
    image={heroImage}
    title="Sustainability Governance of China's Global Infrastructure Investments"
  >
    <p>
      <strong
        >Sustainability Governance of China&#39;s Global Infrastructure
        Investments (SGAIN)</strong
      > is a £1.7 million research project awarded to <strong
        >Dr <a href="https://www.yixiansun.com">Yixian Sun</a></strong
      > at the University of Bath by the UKRI Future Leaders Fellowship.
    </p>
    <p>
      Our seven-year study programme integrates innovative mixed methods to
      assess China&#39;s efforts to promote green development through overseas
      infrastructure investments and also environmental and social impacts of
      key Chinese projects in different host contexts across the Global South.
      Our research aims to advance understanding of China&#39;s overseas
      engagement and its influence on global sustainable development. Our work
      will help policy practitioners develop suitable strategies to align
      international investments with local sustainability needs.
    </p>
    <p class="home-cta-wrap">
      <a class="home-cta" href="/research/">Learn more</a>
    </p>
  </Hero>

  <div class="section-divider"></div>

  <section class="band">
    <div class="about">
      <div class="about__figure">
        <img
          src="/images/remote/assets-zyrosite-com/screenshot-2024-09-11-100621-m2wqr5er0ah1zbym-4d9c09fe7e.png"
          alt=""
        />
      </div>
      <div class="about__copy">
        <h2>About Us</h2>
        <p>
          The project team includes leading researchers across the globe in the
          fields of international relations, environmental governance and
          development studies based at Fudan University (China), Universitas
          Gadjah Mada (Indonesia), University of Dhaka (Bangladesh), Sustainable
          Development Policy Institute (Pakistan), and National University of
          Singapore (Singapore).
        </p>
        <p class="home-cta-wrap">
          <a class="home-cta" href="/team/">Meet the team</a>
        </p>
      </div>
    </div>
  </section>

  <div class="section-divider"></div>

  <section class="band">
    <h2 class="section-title">Recent Updates</h2>
    <div class="card-grid">
      <MediaCard
        href="/publications/bath-conference-on-china-and-global-sustainability-transition/"
        image="/images/remote/assets-zyrosite-com/dsc01886-yleq5rrxkjiqjvop-13b7ce341f.jpg"
        title="Bath Conference June 2025"
      />
      <MediaCard
        href="/publications/"
        image="/images/remote/images-unsplash-com/photo-1523995462485-3d171b5c8fa9-b700a78d0c.jpg"
        imageAlt="bundle of newspaper on table"
        title="SGAIN International News"
      />
    </div>
  </section>
</Layout>
