---
import Hero from "../components/Hero.astro";
import PartnerNetwork from "../components/PartnerNetwork.astro";
import Layout from "../layouts/Layout.astro";

const frontmatter = {
  title: "SGAIN: Network | SGAIN Project",
  description:
    "Explore our global knowledge network that unites researchers and practitioners in sustainability governance. Sign up for our newsletter or contact us to become a project affiliate",
  oldUrl: "https://sgain.org/network",
};

const networkPartners = [
  {
    label: "Bath Social & Development Research Ltd",
    displayLabel: "Bath Social & Development Research",
  },
  {
    label: "Universitas Gadjah Mada",
    displayLabel: "Universitas Gadjah Mada",
  },
  {
    label: "Sustainable Development Policy Institute",
    displayLabel: "SDPI",
  },
  {
    label: "University of Dhaka",
    displayLabel: "University of Dhaka",
  },
  {
    label: "National University of Singapore",
    displayLabel: "NUS",
  },
  {
    label: "Fudan University",
    displayLabel: "Fudan University",
  },
] as const;

const networkCentre = {
  label: "SGAIN Project",
  imageSrc:
    "/images/remote/assets-zyrosite-com/sgain-logo-full-aqepxwr6wafrpnng-32339a3ece.png",
  alt: "SGAIN Project",
} as const;
---

<Layout frontmatter={frontmatter} bare>
  <Hero
    image="/images/remote/images-unsplash-com/photo-1707667573875-207658a82c68-d51e8e4915.jpg"
    title="Network"
  />

  <section class="band prose">
    <p>
      Based on our project, we are building a global knowledge network to involve
      both researchers and practitioners of sustainability governance. Our primary
      goal is to facilitate exchange and promote inclusive knowledge production to
      support global sustainable development. We are particularly interested in
      engaging with colleagues working on the Global South and China’s global
      engagement.
    </p>
    <p>
      Our network will be maintained through a series of channels including
      newsletters, webinars and also in-person events such as workshops and
      conferences. Through these activities, we hope to create more opportunities
      for collaboration. If you are interested in joining us, please sign up <strong
        ><a
          href="https://docs.google.com/forms/d/e/1FAIpQLSeH30yh9itlUx9K8shQfTvc4-IPz5En0Ms0ZkVtXoKxIYCqVQ/viewform"
          target="_blank"
          rel="noopener noreferrer"
          >here</a
        ></strong
      >!
    </p>
  </section>

  <div class="section-divider"></div>

  <section class="band">
    <p class="diagram-caption">
      The diagram below highlights several of our institutional partners across
      the SGAIN network.
    </p>
    <PartnerNetwork centre={networkCentre} partners={networkPartners} />
    <p class="diagram-caption">
      The map below shows the location of all of our international partners and
      collaborators.
    </p>
    <figure class="page-feature">
      <img
        src="/images/remote/assets-zyrosite-com/map-yz9jmp465qsnnk5d-c00d987bff.jpeg"
        alt=""
      />
    </figure>
  </section>

  <div class="section-divider"></div>

  <section class="band">
    <h3 class="section-title"><strong>Project Affiliates</strong></h3>
    <p class="section-intro">
      Our project affiliates include researchers across the globe who collaborate
      with us on various issues. They are key members in our network.
    </p>
    <div class="affiliate-grid">
      <article class="affiliate-card">
        <h6 class="affiliate-card__name">
          <strong
            ><a
              href="https://cc458.github.io/"
              target="_blank"
              rel="noopener noreferrer">Chong Chen</a
            ></strong
          >
        </h6>
        <p class="affiliate-card__role">
          <strong>Associate Professor</strong><br />Tsinghua University
        </p>
      </article>
      <article class="affiliate-card">
        <h6 class="affiliate-card__name">
          <strong
            ><a
              href="https://chuyuliu.weebly.com/"
              target="_blank"
              rel="noopener noreferrer">Chuyu Liu</a
            ></strong
          >
        </h6>
        <p class="affiliate-card__role">
          <strong>Assistant Professor</strong><br />University of Amsterdam
        </p>
      </article>
      <article class="affiliate-card">
        <h6 class="affiliate-card__name">
          <strong
            ><a
              href="https://www.jesserodenbiker.com/"
              target="_blank"
              rel="noopener noreferrer">Jesse Rodenbiker</a
            ></strong
          >
        </h6>
        <p class="affiliate-card__role">
          <strong>Department of Geography</strong><br />Rutgers University
        </p>
      </article>
      <article class="affiliate-card">
        <h6 class="affiliate-card__name">
          <strong
            ><a
              href="https://ppa.hku.hk/f/lihui"
              target="_blank"
              rel="noopener noreferrer">Hui Li</a
            ></strong
          >
        </h6>
        <p class="affiliate-card__role">
          <strong>Assistant Professor</strong><br />University of Hong Kong
        </p>
      </article>
      <article class="affiliate-card">
        <h6 class="affiliate-card__name">
          <strong
            ><a
              href="https://julietlu.com/"
              target="_blank"
              rel="noopener noreferrer">Juliet Lu</a
            ></strong
          >
        </h6>
        <p class="affiliate-card__role">
          <strong>Assistant Professor</strong><br />University of British Columbia
        </p>
      </article>
      <article class="affiliate-card">
        <h6 class="affiliate-card__name">
          <strong
            ><a
              href="https://www.stir.ac.uk/research/hub/people/2034580"
              target="_blank"
              rel="noopener noreferrer">Hyeyoon Park</a
            ></strong
          >
        </h6>
        <p class="affiliate-card__role">
          <strong>Lecturer</strong><br />University of Stirling
        </p>
      </article>
      <article class="affiliate-card">
        <h6 class="affiliate-card__name">
          <strong
            ><a
              href="https://www.kcl.ac.uk/people/thomas-white"
              target="_blank"
              rel="noopener noreferrer">Thomas White</a
            ></strong
          >
        </h6>
        <p class="affiliate-card__role">
          <strong>Lecturer</strong>,<br />King&#39;s College London
        </p>
      </article>
      <article class="affiliate-card">
        <h6 class="affiliate-card__name">
          <strong
            ><a
              href="https://jessicadicarlo.org/"
              target="_blank"
              rel="noopener noreferrer">Jessica DiCarlo</a
            ></strong
          >
        </h6>
        <p class="affiliate-card__role">
          <strong>Assistant Professor</strong><br />University of Utah
        </p>
      </article>
      <article class="affiliate-card">
        <h6 class="affiliate-card__name">
          <strong
            ><a
              href="https://www.tylerharlan.com/about"
              target="_blank"
              rel="noopener noreferrer">Tyler Harlan</a
            ></strong
          >
        </h6>
        <p class="affiliate-card__role">
          <strong>Associate Professor</strong><br />Loyola Marymount University
        </p>
      </article>
      <article class="affiliate-card">
        <h6 class="affiliate-card__name">
          <strong
            ><a
              href="https://research.vu.nl/en/persons/xiaoran-li"
              target="_blank"
              rel="noopener noreferrer">Xiaoran Li</a
            ></strong
          >
        </h6>
        <p class="affiliate-card__role">
          <strong>PhD</strong>
          <strong>Student</strong><br />Vrije Universiteit Amsterdam
        </p>
      </article>
    </div>
  </section>

  <div class="section-divider"></div>

  <section class="band prose">
    <h3 class="section-title"><strong>Visiting Doctoral Fellowship</strong></h3>
    <p>
      Our fellowship programme is to support early career researchers (PhD
      students) who want to work with our project team to conduct research (up to
      six months) as visiting researchers at the University of Bath. Each year, we
      will award a few fellows who will receive travel support for their visit at
      Bath. If you are interested in joining this programme, please submit an
      application or make inquiries at <strong
        ><a href="mailto:sgain@bath.ac.uk">sgain@bath.ac.uk</a></strong
      >.
    </p>
    <p>The application must include:</p>
    <ul>
      <li>
        <p>
          A short research plan (up to 3 pages) with very concrete ideas for at
          least one research article to be co-authored with our team
        </p>
      </li>
      <li>
        <p>
          A cover letter stating explaining your motivation and how the fellowship
          can support your career development
        </p>
      </li>
      <li><p>Your latest CV</p></li>
    </ul>
    <p>
      We evaluate applications on a recurring basis, but the approval of the
      fellowship will follow the admin procedures at the University of Bath and
      may take some time. We advise you to apply 6-9 months before the planned
      state date of your visit.
    </p>
  </section>
</Layout>

<style>
  /* Bands + dividers */
  .band {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4rem) 24px;
  }

  .band.prose {
    max-width: 820px;
  }

  .section-divider {
    padding: 0 24px;
  }

  .section-divider::before {
    content: "";
    display: block;
    max-width: 1100px;
    height: 2px;
    margin: 0 auto;
    background: var(--ink);
  }

  /* Section heading */
  .section-title {
    margin: 0 0 1.25rem;
    color: var(--teal-d);
    font-family: "Fraunces", serif;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 700;
    line-height: 1.16;
  }

  .section-title strong {
    font-weight: 700;
  }

  /* Prose */
  .prose > * + * {
    margin-top: 1.05rem;
  }

  .prose p,
  .prose ul {
    margin: 0;
    color: var(--ink);
    font-family: "Source Serif 4", serif;
    font-size: 1.13rem;
    line-height: 1.62;
  }

  .prose ul {
    padding-left: 1.35rem;
  }

  .prose li + li {
    margin-top: 0.5rem;
  }

  .prose li p {
    margin: 0;
  }

  .prose a {
    color: var(--teal);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }

  .prose a:hover {
    color: var(--rust);
  }

  .prose strong {
    color: var(--ink);
    font-weight: 700;
  }

  /* Diagram + map captions */
  .diagram-caption {
    max-width: 720px;
    margin: 0 auto;
    color: var(--muted);
    font-family: "Source Serif 4", serif;
    font-size: 1.05rem;
    line-height: 1.6;
    text-align: center;
  }

  .section-intro {
    max-width: 760px;
    margin: 0 0 clamp(1.5rem, 4vw, 2.25rem);
    color: var(--muted);
    font-family: "Source Serif 4", serif;
    font-size: 1.08rem;
    line-height: 1.6;
  }

  /* Map feature */
  .page-feature {
    margin: clamp(1.5rem, 4vw, 2.5rem) 0 0;
  }

  .page-feature img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
    box-shadow: var(--shadow);
  }

  /* Affiliate cards */
  .affiliate-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    align-items: start;
  }

  .affiliate-card {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
    padding: 1.1rem 1.25rem;
    box-shadow: 0 6px 22px rgba(38, 51, 63, 0.06);
    transition:
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }

  .affiliate-card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-3px);
  }

  .affiliate-card__name {
    margin: 0;
    font-family: "Fraunces", serif;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .affiliate-card__name strong {
    font-weight: 600;
  }

  .affiliate-card__name a {
    color: var(--teal-d);
    text-decoration: none;
  }

  .affiliate-card__name a:hover {
    color: var(--rust);
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .affiliate-card__role {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-family: "Work Sans", sans-serif;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .affiliate-card__role strong {
    color: var(--rust);
    font-weight: 600;
  }

  @media (min-width: 640px) {
    .affiliate-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .affiliate-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .page-feature img {
      border-radius: 12px;
    }
  }
</style>
