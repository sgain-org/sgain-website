---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Band from "@/components/Band.astro";
import Hero from "@/components/Hero.astro";
import SectionDivider from "@/components/SectionDivider.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import Layout from "@/layouts/Layout.astro";
import { byDateDesc } from "@/lib/content";

type Section = CollectionEntry<"multimedia">["data"]["section"];

const allMedia = await getCollection("multimedia");

/** Entries for one section, newest first, with the description rendered. */
const bySection = (section: Section) =>
  Promise.all(
    allMedia
      .filter((entry) => entry.data.section === section)
      .sort(byDateDesc)
      .map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
  );

const conferenceCoverage = await bySection("conference-coverage");
const interviews = await bySection("interviews");

const frontmatter = {
  title: "Multimedia | SGAIN Project",
  description:
    "Conference coverage and interviews from the SGAIN Project, including videos from the 2025 Bath Conference and recent media appearances.",
};

---

<Layout frontmatter={frontmatter} bare>
  <Hero
    image="/images/pages/shared/publications-hero.jpg"
    title="Multimedia"
  />

  <Band aria-labelledby="conference-coverage-title">
    <SectionTitle id="conference-coverage-title">
      Insights from the 2025 Bath Conference
    </SectionTitle>
    <div class="media-grid">
      {
        conferenceCoverage.map(({ entry: { data }, Content }) => (
          <article
            class:list={[
              "media-card",
              data.embed.variant === "portrait" && "media-card--portrait",
              data.embed.variant === "audio" && "media-card--audio",
            ]}
          >
            <div class="media-card__embed">
              <iframe
                class:list={[
                  "media-frame",
                  data.embed.variant === "portrait" && "media-frame--portrait",
                  data.embed.variant === "audio" && "media-frame--audio",
                ]}
                src={data.embed.src}
                title={data.title}
                width={data.embed.width}
                height={data.embed.height}
                loading="lazy"
                allow={data.embed.allow}
                sandbox={data.embed.sandbox}
                allowfullscreen={data.embed.allowFullScreen}
              />
            </div>
            <div class="media-card__body">
              <h3>{data.title}</h3>
              <Content />
            </div>
          </article>
        ))
      }
    </div>
  </Band>

  <SectionDivider />

  <Band aria-labelledby="interviews-title">
    <SectionTitle id="interviews-title">Interviews</SectionTitle>
    <div class="media-grid">
      {
        interviews.map(({ entry: { data }, Content }) => (
          <article
            class:list={[
              "media-card",
              data.embed.variant === "portrait" && "media-card--portrait",
              data.embed.variant === "audio" && "media-card--audio",
            ]}
          >
            <div class="media-card__embed">
              <iframe
                class:list={[
                  "media-frame",
                  data.embed.variant === "portrait" && "media-frame--portrait",
                  data.embed.variant === "audio" && "media-frame--audio",
                ]}
                src={data.embed.src}
                title={data.title}
                width={data.embed.width}
                height={data.embed.height}
                loading="lazy"
                allow={data.embed.allow}
                sandbox={data.embed.sandbox}
                allowfullscreen={data.embed.allowFullScreen}
              />
            </div>
            <div class="media-card__body">
              <h3>{data.title}</h3>
              <Content />
            </div>
          </article>
        ))
      }
    </div>
  </Band>
</Layout>

<style>
  .media-grid {
    display: grid;
    gap: 1.5rem;
  }

  .media-card {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 1.25rem;
    align-items: start;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--paper);
    padding: 1.25rem;
    box-shadow: var(--shadow);
  }

  .media-card--portrait {
    grid-template-columns: minmax(220px, 320px) minmax(0, 1fr);
  }

  .media-card__embed {
    display: grid;
    align-content: start;
  }

  .media-card__body {
    min-width: 0;
  }

  .media-card__body h3 {
    margin: 0;
    color: var(--teal-d);
    font-size: 1.45rem;
  }

  /* The description is the entry body, so it needs :global to reach the rendered <p>. */
  .media-card__body :global(p) {
    margin-top: 0.85rem;
    margin-bottom: 0;
  }

  .media-frame {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    background: #000;
  }

  .media-frame--portrait {
    max-width: 320px;
    aspect-ratio: 267 / 476;
    margin-inline: auto;
    background: transparent;
  }

  .media-frame--audio {
    aspect-ratio: auto;
    min-height: 175px;
    background: transparent;
  }

  @media (max-width: 820px) {
    .media-card,
    .media-card--portrait,
    .media-card--audio {
      grid-template-columns: 1fr;
    }

    .media-frame--portrait {
      max-width: 280px;
    }
  }
</style>
