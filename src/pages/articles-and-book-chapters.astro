---

<Layout frontmatter={frontmatter} bare>
  <Hero
    image="/images/photo-1528214968864-8dd00782fa9e-132b852a90.jpg"
    title="Articles and Book Chapters"
  />

  <Band>
    <p class="pub-lead">
      Read the most recent publications from members of our team in journals and
      books
    </p>

    <div class="pub-grid">
      {
        publications.map((publication) => (
          <PublicationCard
            meta={publication.type}
            title={publication.title}
            href={`/publications/${publication.slug}/`}
            lines={[publication.citation]}
          />
        ))
      }
    </div>
  </Band>
</Layout>

<style>
  .pub-lead {
    margin: 0 0 clamp(1.5rem, 4vw, 2.25rem);
    max-width: 70ch;
    color: var(--muted);
    font-family: "Source Serif 4", serif;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .pub-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    align-items: start;
  }

  @media (min-width: 720px) {
    .pub-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
