---
import Prose from "@/components/Prose.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import "@/styles/styles.css";

interface Frontmatter {
  title?: string;
  description?: string;
  image?: string;
  oldUrl?: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  frontmatter?: Frontmatter;
  bare?: boolean;
}

const {
  frontmatter = {},
  title: propTitle,
  description: propDescription,
  image: propImage,
  bare = false,
} = Astro.props as Props;

const title = propTitle ?? frontmatter.title ?? "SGAIN Project";
const description =
  propDescription ??
  frontmatter.description ??
  "Sustainability Governance of China's Global Infrastructure Investments, a UKRI Future Leaders Fellowship project at the University of Bath.";
const image = propImage ?? frontmatter.image;

const site = Astro.site ?? new URL("https://sgain.org");
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = image ? new URL(image, site).toString() : undefined;
---

<style>
  .site-main {
    padding: 54px 24px 78px;
  }

  .site-main--flush {
    padding: 0;
  }

  @media (max-width: 680px) {
    .site-main {
      padding: 34px 16px 58px;
    }
  }
</style>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SGAIN Project" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=Work+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteHeader />

    {
      bare ? (
        <main id="content" class="site-main site-main--flush">
          <slot />
        </main>
      ) : (
        <main id="content" class="site-main">
          <Prose>
            <slot />
          </Prose>
        </main>
      )
    }

    <SiteFooter />
  </body>
</html>
