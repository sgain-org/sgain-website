---
import Prose from "@/components/Prose.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import {
  SITE_DESCRIPTION,
  SITE_KEYWORDS,
  SITE_NAME,
  SITE_URL,
} from "@/lib/site";
import "@/styles/styles.css";

interface Frontmatter {
  title?: string;
  description?: string;
  image?: string;
  oldUrl?: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
  frontmatter?: Frontmatter;
  bare?: boolean;
}

const {
  frontmatter = {},
  title: propTitle,
  description: propDescription,
  image: propImage,
  keywords = SITE_KEYWORDS,
  bare = false,
} = Astro.props as Props;

const title = propTitle ?? frontmatter.title ?? SITE_NAME;
const description = propDescription ?? frontmatter.description ?? SITE_DESCRIPTION;
const image = propImage ?? frontmatter.image;

const site = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL(image ?? "/og-image.png", site).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE_URL}/#organization`,
      name: SITE_NAME,
      url: SITE_URL,
      logo: `${SITE_URL}/logos/SGAIN_Logo_full.png`,
      parentOrganization: {
        "@type": "CollegeOrUniversity",
        name: "University of Bath",
        url: "https://www.bath.ac.uk",
      },
      funder: {
        "@type": "Organization",
        name: "UK Research and Innovation",
        alternateName: "UKRI",
        url: "https://www.ukri.org",
      },
    },
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      name: SITE_NAME,
      url: SITE_URL,
      description: SITE_DESCRIPTION,
      publisher: { "@id": `${SITE_URL}/#organization` },
    },
  ],
};
---

<style>
  .site-main {
    padding: 54px 24px 78px;
  }

  .site-main--flush {
    padding: 0;
  }

  @media (max-width: 680px) {
    .site-main {
      padding: 34px 16px 58px;
    }
  }
</style>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="SGAIN — University of Bath" />
    <meta name="theme-color" content="#5b7a96" />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=Work+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteHeader />

    {
      bare ? (
        <main id="content" class="site-main site-main--flush">
          <slot />
        </main>
      ) : (
        <main id="content" class="site-main">
          <Prose>
            <slot />
          </Prose>
        </main>
      )
    }

    <SiteFooter />
  </body>
</html>
